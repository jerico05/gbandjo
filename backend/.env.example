# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais versionner .env.

# Obligatoire
DATABASE_URL=postgresql://utilisateur:mot_de_passe@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=remplacer-par-une-longueur-aleatoire-d-au-moins-32-octets

# CORS (frontends React, séparés par des virgules)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

# Cloudinary (images produits — upload commerçant)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=gbandjo/products

# INTERNAL_CRON_KEY=change-me-for-post-internal-expirer-reservations
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7

# Tests : base PostgreSQL dédiée (jamais la base de développement)
# TEST_DATABASE_URL=postgresql://utilisateur:mot_de_passe@localhost:5432/gbandjo_test
